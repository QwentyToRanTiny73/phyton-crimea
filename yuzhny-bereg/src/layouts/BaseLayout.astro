---
import '@/styles/global.css';
import type { Photo } from '@/types/domain';
import SeoHead from '@/components/layout/SeoHead.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { getCatalog } from '@/lib/catalog';
import { breadcrumbSchema, type Crumb } from '@/lib/seo';
import { absoluteUrl } from '@/lib/url';
import { SITE } from '@/data/site';

interface Props {
  title: string;
  description: string;
  image?: Photo | undefined;
  noindex?: boolean | undefined;
  ogType?: 'website' | 'article' | undefined;
  jsonLd?: (Record<string, unknown> | undefined)[] | undefined;
  breadcrumbs?: Crumb[] | undefined;
  /** Прозрачная шапка поверх первого экрана (главная страница). */
  overlayHeader?: boolean | undefined;
}

const { title, description, noindex, ogType, jsonLd = [], breadcrumbs, overlayHeader = false } = Astro.props;
const catalog = await getCatalog();
const image = Astro.props.image ?? catalog.photos.find((p) => p.id === SITE.heroPhoto);
const site = Astro.site;
const schemas = breadcrumbs?.length ? [...jsonLd, breadcrumbSchema(breadcrumbs, (href) => absoluteUrl(href, site))] : jsonLd;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f4ec" />
    <meta name="format-detection" content="telephone=no" />
    <SeoHead title={title} description={description} image={image} noindex={noindex} ogType={ogType} jsonLd={schemas} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-graphite px-4 py-2 text-sm text-milk focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Перейти к содержанию</a
    >
    <Header overlay={overlayHeader} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
