---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import SettlementCard from '@/components/cards/SettlementCard.astro';
import { getCatalog, listingsInSettlement } from '@/lib/catalog';
import { routes } from '@/lib/url';

const catalog = await getCatalog();
const crumbs = [
  { label: 'Главная', href: routes.home() },
  { label: 'География', href: routes.geography() },
];
const regions = catalog.regions.map((r) => ({ region: r, settlements: catalog.settlements.filter((s) => s.region.id === r.id) }));
---

<BaseLayout
  title="География: города и посёлки Большой Ялты"
  description="Ялта, Гурзуф, Никита, Массандра, Ливадия, Ореанда, Гаспра, Кореиз, Алупка, Симеиз и Форос — места, организации и события по населённым пунктам."
  breadcrumbs={crumbs}
>
  <PageHeader
    breadcrumbs={crumbs}
    eyebrow="География"
    title="Направления Южного берега"
    intro="Платформа начинается с Большой Ялты. Следующими появятся Алушта, Судак и другие районы Южного берега Крыма."
  />
  <div class="container-page space-y-16 py-10">
    {
      regions.map(({ region, settlements }) => (
        <section aria-labelledby={`region-${region.id}`}>
          <div class="max-w-3xl">
            <h2 id={`region-${region.id}`} class="text-3xl">
              {region.title}
            </h2>
            <p class="mt-3 leading-relaxed text-muted">{region.description}</p>
          </div>
          <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
            {settlements.map((s) => (
              <li>
                <SettlementCard settlement={s} count={listingsInSettlement(catalog, s.id).length} sizes="(min-width: 1024px) 300px, (min-width: 768px) 33vw, 50vw" />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
