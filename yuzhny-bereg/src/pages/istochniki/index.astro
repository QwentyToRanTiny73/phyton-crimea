---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { getCatalog } from '@/lib/catalog';
import { routes } from '@/lib/url';

const catalog = await getCatalog();
const photos = [...catalog.photos].sort((a, b) => a.alt.localeCompare(b.alt, 'ru'));
const crumbs = [
  { label: 'Главная', href: routes.home() },
  { label: 'Источники и фото', href: routes.sources() },
];
---

<BaseLayout
  title="Источники данных и авторы фотографий"
  description="Откуда берутся сведения справочника «Южный берег» и кто автор фотографий: Википедия, Викиданные, Wikimedia Commons."
  breadcrumbs={crumbs}
>
  <PageHeader
    breadcrumbs={crumbs}
    eyebrow="Прозрачность"
    title="Источники и фото"
    intro="Справочные сведения о реальных местах взяты из Википедии и Викиданных, ссылки указаны на страницах объектов. Все фотографии — с Wikimedia Commons под свободными лицензиями."
  />
  <div class="container-page py-10">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        photos.map((p) => (
          <li class="flex gap-4 rounded-card bg-white p-3 shadow-card">
            <Image src={p.src} alt="" widths={[160, 240]} sizes="96px" class="size-24 shrink-0 rounded-xl object-cover" />
            <div class="min-w-0 text-sm">
              <p class="line-clamp-2 font-medium text-graphite">{p.alt}</p>
              <p class="mt-1 text-muted">Автор: {p.author}</p>
              <p class="mt-1 text-xs text-muted">
                {p.licenseUrl ? (
                  <a href={p.licenseUrl} rel="license noopener" target="_blank" class="underline underline-offset-2">
                    {p.license}
                  </a>
                ) : (
                  p.license
                )}
                {' · '}
                <a href={p.sourceUrl} rel="noopener" target="_blank" class="underline underline-offset-2">
                  {p.sourceName}
                </a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 max-w-3xl text-sm text-muted">
      Фото обработаны для веба (масштаб и сжатие) без изменения содержания. Лицензии CC BY и CC BY-SA допускают такое использование при
      указании автора и лицензии.
    </p>
  </div>
</BaseLayout>
