---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import CategoryCard from '@/components/cards/CategoryCard.astro';
import { countByCategory, getCatalog } from '@/lib/catalog';
import { routes } from '@/lib/url';

const catalog = await getCatalog();
const counts = countByCategory(catalog);
const crumbs = [
  { label: 'Главная', href: routes.home() },
  { label: 'Категории', href: routes.categories() },
];
---

<BaseLayout
  title="Категории справочника"
  description="Где остановиться, где поесть, культура и история, природа, экскурсии, активный отдых, море, мероприятия, мастера и услуги Большой Ялты."
  breadcrumbs={crumbs}
>
  <PageHeader
    breadcrumbs={crumbs}
    eyebrow="Категории"
    title="Разделы справочника"
    intro="Каждая категория — отдельная подборка мест, организаций и услуг с фильтрами по посёлкам и типам."
  />
  <div class="container-page py-10">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {catalog.categories.map((c) => <li><CategoryCard category={c} count={counts.get(c.id)} /></li>)}
    </ul>
  </div>
</BaseLayout>
