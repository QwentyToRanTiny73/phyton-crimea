---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import GuideCard from '@/components/cards/GuideCard.astro';
import { getCatalog } from '@/lib/catalog';
import { routes } from '@/lib/url';

const catalog = await getCatalog();
const crumbs = [
  { label: 'Главная', href: routes.home() },
  { label: 'Подборки', href: routes.guides() },
];
---

<BaseLayout
  title="Подборки и тематические маршруты по Большой Ялте"
  description="Готовые маршруты на день: дворцы Южного берега, природные символы западного побережья, литературные места Ялты и Гурзуфа, тропы и смотровые площадки."
  breadcrumbs={crumbs}
>
  <PageHeader breadcrumbs={crumbs} eyebrow="Подборки" title="Маршруты и тематические подборки" intro="Связки мест, которые удобно посмотреть за день или выходные." />
  <div class="container-page py-10">
    <ul class="grid gap-5 lg:grid-cols-2">
      {catalog.guides.map((g) => <li><GuideCard guide={g} /></li>)}
    </ul>
  </div>
</BaseLayout>
