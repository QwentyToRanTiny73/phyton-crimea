---
import { RotateCcw, Search } from '@lucide/astro';
import type { Category, Listing, ServiceType, Settlement } from '@/types/domain';
import ListingCard from '@/components/cards/ListingCard.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { normalize } from '@/lib/search';
import { countLabel, isoDate, KIND_LABEL } from '@/lib/format';

interface Props {
  listings: Listing[];
  categories: Category[];
  settlements: Settlement[];
  serviceTypes: ServiceType[];
}
const { listings, categories, settlements, serviceTypes } = Astro.props;

// Порядок «по умолчанию»: рекомендованные, затем реальные записи, затем демо; внутри — по алфавиту.
const ranked = [...listings].sort(
  (a, b) => Number(b.featured) - Number(a.featured) || Number(a.demo) - Number(b.demo) || a.title.localeCompare(b.title, 'ru'),
);
const listingCategories = categories.filter((c) => c.section === 'listings');
const typesByCategory = listingCategories
  .map((c) => ({ category: c, types: serviceTypes.filter((t) => t.category.id === c.id) }))
  .filter((g) => g.types.length > 0);

const searchText = (l: Listing) =>
  normalize(
    [
      l.title,
      l.summary,
      l.category.title,
      ...l.extraCategories.map((c) => c.title),
      l.settlement.title,
      ...l.locations.map((x) => x.settlement.title),
      ...l.serviceTypes.map((t) => t.title),
      ...l.tags,
      ...l.features,
      KIND_LABEL[l.kind],
    ].join(' '),
  );
---

<div data-catalog class="group/catalog">
  <form data-catalog-form role="search" aria-label="Поиск и фильтры каталога" class="rounded-card border border-line/70 bg-white/70 p-4 shadow-card sm:p-5">
    <label for="catalog-q" class="sr-only">Поиск по каталогу</label>
    <div class="relative">
      <Search size={20} class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted" aria-hidden="true" />
      <input
        id="catalog-q"
        name="q"
        type="search"
        enterkeyhint="search"
        autocomplete="off"
        placeholder="Дворец, водопад, SUP, кофейня…"
        class="field h-12 pl-12 text-base"
      />
    </div>

    <div class="mt-3 grid grid-cols-2 gap-3 lg:grid-cols-5">
      <div>
        <label for="catalog-category" class="mb-1 block text-xs font-semibold text-muted">Категория</label>
        <select id="catalog-category" name="category" class="field">
          <option value="">Все категории</option>
          {listingCategories.map((c) => <option value={c.id}>{c.title}</option>)}
        </select>
      </div>
      <div>
        <label for="catalog-settlement" class="mb-1 block text-xs font-semibold text-muted">Населённый пункт</label>
        <select id="catalog-settlement" name="settlement" class="field">
          <option value="">Вся Большая Ялта</option>
          {settlements.map((s) => <option value={s.id}>{s.title}</option>)}
        </select>
      </div>
      <div>
        <label for="catalog-type" class="mb-1 block text-xs font-semibold text-muted">Тип услуги</label>
        <select id="catalog-type" name="type" class="field">
          <option value="">Любой тип</option>
          {
            typesByCategory.map((g) => (
              <optgroup label={g.category.title}>
                {g.types.map((t) => (
                  <option value={t.id}>{t.title}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </div>
      <div>
        <label for="catalog-kind" class="mb-1 block text-xs font-semibold text-muted">Тип объекта</label>
        <select id="catalog-kind" name="kind" class="field">
          <option value="">Все</option>
          <option value="place">Места</option>
          <option value="organization">Организации</option>
          <option value="service">Услуги</option>
        </select>
      </div>
      <div class="col-span-2 lg:col-span-1">
        <label for="catalog-sort" class="mb-1 block text-xs font-semibold text-muted">Сортировка</label>
        <select id="catalog-sort" name="sort" class="field">
          <option value="rank">Сначала рекомендуемые</option>
          <option value="title">По названию</option>
          <option value="new">Сначала новые</option>
          <option value="updated">Недавно обновлённые</option>
        </select>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <p data-count aria-live="polite" class="text-sm font-semibold text-graphite">
        {countLabel(listings.length, ['объект', 'объекта', 'объектов'])}
      </p>
      <button type="reset" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-graphite">
        <RotateCcw size={15} aria-hidden="true" />
        Сбросить фильтры
      </button>
    </div>
    <noscript><p class="mt-3 text-sm text-muted">Фильтры работают при включённом JavaScript. Ниже показаны все объекты.</p></noscript>
  </form>

  <ul data-results class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" aria-label="Результаты">
    {
      ranked.map((l, i) => (
        <li
          data-item
          data-id={l.id}
          data-rank={i}
          data-title={l.title}
          data-search={searchText(l)}
          data-category={[l.category.id, ...l.extraCategories.map((c) => c.id)].join(' ')}
          data-settlement={[l.settlement.id, ...l.locations.map((x) => x.settlement.id)].join(' ')}
          data-type={l.serviceTypes.map((t) => t.id).join(' ')}
          data-kind={l.kind}
          data-created={isoDate(l.createdAt)}
          data-updated={isoDate(l.updatedAt)}
        >
          <ListingCard listing={l} />
        </li>
      ))
    }
  </ul>

  <div data-empty hidden class="mt-8">
    <EmptyState title="Ничего не найдено" text="Попробуйте изменить запрос или сбросить фильтры. Если нужного места нет в каталоге — предложите его.">
      <button type="button" data-reset-all class="btn-secondary mt-5">Сбросить фильтры</button>
    </EmptyState>
  </div>
</div>

<script>
  import { initCatalog } from '@/scripts/catalog';
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach(initCatalog);
</script>
