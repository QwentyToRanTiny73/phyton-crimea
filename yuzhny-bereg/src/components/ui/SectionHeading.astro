---
import { ArrowRight } from '@lucide/astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  link?: { href: string; label: string };
  as?: 'h1' | 'h2';
  id?: string;
}
const { eyebrow, title, description, link, as: Tag = 'h2', id } = Astro.props;
---

<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag id={id} class:list={['mt-2', Tag === 'h1' ? 'text-4xl sm:text-5xl' : 'text-3xl sm:text-4xl']}>{title}</Tag>
    {description && <p class="mt-3 text-base leading-relaxed text-muted">{description}</p>}
  </div>
  {
    link && (
      <a href={link.href} class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-graphite">
        {link.label}
        <ArrowRight size={16} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    )
  }
</div>
