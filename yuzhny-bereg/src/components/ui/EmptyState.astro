---
import { SearchX } from '@lucide/astro';
interface Props {
  title: string;
  text?: string;
}
const { title, text } = Astro.props;
---

<div class="flex flex-col items-center rounded-card border border-dashed border-line bg-white/50 px-6 py-14 text-center">
  <SearchX size={32} class="text-muted" aria-hidden="true" />
  <p class="mt-4 font-serif text-xl text-graphite">{title}</p>
  {text && <p class="mt-2 max-w-md text-sm text-muted">{text}</p>}
  <slot />
</div>
