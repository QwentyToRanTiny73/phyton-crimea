---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full border border-terracotta/40 bg-white/90 px-2.5 py-0.5 text-[0.6875rem] font-semibold tracking-wide text-terracotta-dark uppercase',
    className,
  ]}
  title="Тестовая запись для проверки интерфейса: название и описание вымышлены">Демо</span
>
