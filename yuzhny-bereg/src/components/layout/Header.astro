---
import { Menu, Plus, X } from '@lucide/astro';
import Logo from './Logo.astro';
import { NAV_ITEMS } from './nav';
import { routes, url } from '@/lib/url';

interface Props {
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (match: string) => path.startsWith(url(match));
---

<header
  class:list={[
    'z-40 w-full',
    overlay ? 'absolute inset-x-0 top-0 text-white' : 'sticky top-0 border-b border-line/70 bg-milk/90 text-graphite backdrop-blur-md',
  ]}
>
  <div class="container-page flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
    <a href={routes.home()} class="rounded-lg" aria-label="Южный берег — на главную">
      <Logo />
    </a>

    <nav aria-label="Основная навигация" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.match) ? 'page' : undefined}
                class:list={[
                  'rounded-full px-4 py-2 text-sm font-medium transition-colors',
                  overlay ? 'hover:bg-white/15' : 'hover:bg-sand-100',
                  isActive(item.match) && (overlay ? 'bg-white/15' : 'bg-sand-100 text-graphite'),
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={routes.suggest()}
        class:list={[
          'hidden sm:inline-flex',
          overlay ? 'btn border border-white/40 text-white hover:bg-white/15' : 'btn-secondary',
        ]}
      >
        <Plus size={16} aria-hidden="true" />
        Предложить объект
      </a>

      <details class="group relative lg:hidden" data-mobile-menu>
        <summary
          class:list={[
            'flex size-11 cursor-pointer list-none items-center justify-center rounded-full [&::-webkit-details-marker]:hidden',
            overlay ? 'hover:bg-white/15' : 'hover:bg-sand-100',
          ]}
          aria-label="Открыть меню"
        >
          <Menu size={22} class="group-open:hidden" aria-hidden="true" />
          <X size={22} class="hidden group-open:block" aria-hidden="true" />
        </summary>
        <div
          class="fixed inset-x-3 top-[4.25rem] rounded-card border border-line bg-milk p-3 text-graphite shadow-lift"
        >
          <nav aria-label="Мобильная навигация">
            <ul class="divide-y divide-line/70">
              {
                NAV_ITEMS.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.match) ? 'page' : undefined}
                      class="flex items-center justify-between px-3 py-3.5 text-base font-medium aria-[current=page]:text-terracotta"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <a href={routes.suggest()} class="btn-accent mt-3 w-full">
            <Plus size={16} aria-hidden="true" />
            Предложить объект
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Закрывает мобильное меню по Escape и при клике вне панели (меню работает и без JS через <details>).
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (menu) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
    });
    menu.addEventListener('toggle', () => {
      menu.querySelector('summary')?.setAttribute('aria-label', menu.open ? 'Закрыть меню' : 'Открыть меню');
    });
  }
</script>
