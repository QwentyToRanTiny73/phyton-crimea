---
import { getImage } from 'astro:assets';
import type { Photo } from '@/types/domain';
import { SITE } from '@/data/site';
import { absoluteUrl, url } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  image?: Photo | undefined;
  noindex?: boolean | undefined;
  ogType?: 'website' | 'article' | undefined;
  jsonLd?: (Record<string, unknown> | undefined)[] | undefined;
}

const { title, description, image, noindex = false, ogType = 'website', jsonLd = [] } = Astro.props;

const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;
// Страница ошибки не получает canonical: у неё нет собственного адреса.
const isErrorPage = /\/404(?:\.html|\/)?$/.test(Astro.url.pathname);
const canonical = isErrorPage ? undefined : absoluteUrl(Astro.url.pathname, Astro.site);
const og = image ? await getImage({ src: image.src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 }) : undefined;
const ogImage = og ? absoluteUrl(og.src, Astro.site) : undefined;
const schemas = jsonLd.filter((s): s is Record<string, unknown> => Boolean(s));
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{
  ogImage && image && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={image.alt} />
    </>
  )
}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="sitemap" href={url('/sitemap.xml')} />
{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
