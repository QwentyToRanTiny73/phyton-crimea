---
import { SITE } from '@/data/site';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true" class="shrink-0">
    <circle cx="17" cy="17" r="16" fill="currentColor" opacity="0.08"></circle>
    <circle cx="17" cy="13.5" r="5.5" fill="#a5512e"></circle>
    <path d="M5 21.5c2.4 0 2.4-1.6 4.8-1.6s2.4 1.6 4.8 1.6 2.4-1.6 4.8-1.6 2.4 1.6 4.8 1.6 2.4-1.6 4.8-1.6" fill="none" stroke="#1d5a78" stroke-width="2" stroke-linecap="round"></path>
    <path d="M7 25.5c2 0 2-1.3 4-1.3s2 1.3 4 1.3 2-1.3 4-1.3 2 1.3 4 1.3 2-1.3 4-1.3" fill="none" stroke="#5b6a2e" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <span class="leading-none">
    <span class="block font-serif text-lg font-semibold tracking-tight">{SITE.name}</span>
    <span class="mt-0.5 block text-[0.6875rem] font-medium tracking-[0.08em] uppercase opacity-70">{SITE.tagline}</span>
  </span>
</span>
