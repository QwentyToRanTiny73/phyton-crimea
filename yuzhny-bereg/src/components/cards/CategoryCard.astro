---
import { ArrowUpRight } from '@lucide/astro';
import type { Category } from '@/types/domain';
import { ICONS } from '@/lib/icons';
import { TONE } from '@/lib/tone';
import { countLabel } from '@/lib/format';
import { routes } from '@/lib/url';

interface Props {
  category: Category;
  count?: number | undefined;
  compact?: boolean;
}
const { category: c, count, compact = false } = Astro.props;
const Icon = ICONS[c.icon];
const tone = TONE[c.tone];
const forms = c.section === 'events' ? (['событие', 'события', 'событий'] as const) : (['объект', 'объекта', 'объектов'] as const);
---

<article
  class:list={[
    'group relative flex h-full min-w-0 flex-col rounded-card border border-line/60 bg-white transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lift',
    compact ? 'p-4' : 'p-5 sm:p-6',
  ]}
>
  <div class="flex items-start justify-between">
    <span class:list={['inline-flex items-center justify-center rounded-2xl', tone.surface, tone.ink, compact ? 'size-10' : 'size-12']}>
      <Icon size={compact ? 20 : 24} stroke-width={1.75} aria-hidden="true" />
    </span>
    <ArrowUpRight size={18} class="text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
  </div>
  <h3 class:list={['font-serif leading-snug hyphens-auto [overflow-wrap:anywhere]', compact ? 'mt-3 text-base' : 'mt-5 text-xl']}>
    <a href={routes.category(c.slug)} class="card-link focus-visible:outline-none">{c.title}</a>
  </h3>
  {!compact && <p class="mt-2 text-sm leading-relaxed text-muted">{c.summary}</p>}
  {count !== undefined && <p class="mt-auto pt-3 text-xs font-semibold text-graphite-soft">{countLabel(count, forms)}</p>}
</article>
