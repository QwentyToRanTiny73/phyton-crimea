---
import { Clock, MapPin } from '@lucide/astro';
import type { EventItem } from '@/types/domain';
import DemoBadge from '@/components/ui/DemoBadge.astro';
import { formatDateRange, formatMonthShort, formatTimeRange, formatWeekday } from '@/lib/format';
import { routes } from '@/lib/url';

interface Props {
  event: EventItem;
  headingLevel?: 'h2' | 'h3';
}
const { event: e, headingLevel: H = 'h3' } = Astro.props;
const time = formatTimeRange(e.startTime, e.endTime);
---

<article class="group relative flex h-full gap-4 rounded-card bg-white p-4 shadow-card transition-shadow duration-300 hover:shadow-lift sm:p-5">
  <div class="flex w-16 shrink-0 flex-col items-center justify-center self-start rounded-2xl bg-terracotta-soft py-3 text-terracotta-dark sm:w-[4.5rem]">
    <span class="font-serif text-2xl leading-none font-semibold">{e.startDate.getUTCDate()}</span>
    <span class="mt-1 text-xs font-semibold uppercase">{formatMonthShort(e.startDate)}</span>
    <span class="mt-0.5 text-[0.6875rem] text-terracotta-dark/80">{formatWeekday(e.startDate)}</span>
  </div>
  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class="text-xs font-semibold text-terracotta-dark">{e.eventCategory.title}</span>
      {e.demo && <DemoBadge />}
      <span hidden data-past-badge class="rounded-full bg-sand-100 px-2 py-0.5 text-[0.6875rem] font-semibold text-muted uppercase">Прошло</span>
    </div>
    <H class="mt-1.5 font-serif text-lg leading-snug sm:text-xl">
      <a href={routes.event(e.slug)} class="card-link focus-visible:outline-none">{e.title}</a>
    </H>
    <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted">{e.summary}</p>
    <p class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-3 text-xs text-graphite-soft">
      <span class="inline-flex items-center gap-1"><Clock size={13} aria-hidden="true" />{formatDateRange(e.startDate, e.endDate)}{time && `, ${time}`}</span>
      <span class="inline-flex items-center gap-1"><MapPin size={13} aria-hidden="true" />{e.settlement.title}</span>
    </p>
  </div>
</article>
