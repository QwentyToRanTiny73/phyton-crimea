---
import { Image } from 'astro:assets';
import { MapPin } from '@lucide/astro';
import type { Listing } from '@/types/domain';
import Cover from '@/components/ui/Cover.astro';
import DemoBadge from '@/components/ui/DemoBadge.astro';
import { KIND_LABEL } from '@/lib/format';
import { routes } from '@/lib/url';

interface Props {
  listing: Listing;
  headingLevel?: 'h2' | 'h3';
  sizes?: string;
}
const {
  listing: l,
  headingLevel: H = 'h3',
  sizes = '(min-width: 1280px) 400px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
} = Astro.props;
const photo = l.photos[0];
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-card bg-white shadow-card transition-shadow duration-300 hover:shadow-lift">
  <div class="relative aspect-[4/3] overflow-hidden bg-sand-100">
    {
      photo ? (
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[400, 640, 800]}
          sizes={sizes}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <Cover tone={l.category.tone} icon={l.category.icon} />
      )
    }
    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
      <span class="rounded-full bg-white/90 px-2.5 py-0.5 text-xs font-semibold text-graphite backdrop-blur">{l.category.shortTitle}</span>
      {l.demo && <DemoBadge />}
    </div>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="flex items-center gap-1.5 text-xs font-medium text-muted">
      <MapPin size={14} aria-hidden="true" />
      {l.settlement.title}
      <span aria-hidden="true">·</span>
      {KIND_LABEL[l.kind]}
    </p>
    <H class="mt-2 font-serif text-xl leading-snug">
      <a href={routes.listing(l.slug)} class="card-link focus-visible:outline-none">{l.title}</a>
    </H>
    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{l.summary}</p>
    {
      l.serviceTypes.length > 0 && (
        <ul class="mt-auto flex flex-wrap gap-1.5 pt-4" aria-label="Типы">
          {l.serviceTypes.slice(0, 3).map((t) => (
            <li class="rounded-full bg-sand-50 px-2.5 py-0.5 text-xs text-graphite-soft">{t.title}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
