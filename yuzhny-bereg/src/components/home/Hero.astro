---
import { Image } from 'astro:assets';
import { Search } from '@lucide/astro';
import type { Category, Photo } from '@/types/domain';
import { ICONS } from '@/lib/icons';
import { routes } from '@/lib/url';

interface Props {
  photo: Photo;
  categories: Category[];
  stats: { listings: number; settlements: number; events: number };
}
const { photo, categories, stats } = Astro.props;
const quick = categories.filter((c) => ['kultura-i-istoriya', 'priroda', 'more', 'gde-poest'].includes(c.id));
---

<section class="relative isolate flex min-h-[88svh] items-end overflow-hidden bg-graphite text-white sm:min-h-[82svh]">
  <Image
    src={photo.src}
    alt={photo.alt}
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    priority
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-graphite/90 via-graphite/45 to-graphite/30"></div>

  <div class="container-page pt-28 pb-12 sm:pb-16 lg:pb-20">
    <p class="eyebrow text-white/80">Южный берег Крыма · первый этап — Большая Ялта</p>
    <h1 class="mt-4 max-w-4xl text-[2.6rem] leading-[1.05] text-white sm:text-6xl lg:text-7xl">
      Всё интересное от Фороса до Гурзуфа — в одном гиде
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/85 sm:text-lg">
      Дворцы и тропы, кафе и винодельни, гиды, морские прогулки, мастера и события. Найдите место, услугу или повод выбраться
      — и сразу узнайте, где это и как туда попасть.
    </p>

    <form action={routes.catalog()} method="get" role="search" class="mt-8 max-w-2xl">
      <label for="hero-q" class="sr-only">Поиск по каталогу</label>
      <div class="flex items-center gap-2 rounded-full bg-white p-1.5 pl-5 shadow-lift">
        <Search size={20} class="shrink-0 text-muted" aria-hidden="true" />
        <input
          id="hero-q"
          name="q"
          type="search"
          enterkeyhint="search"
          placeholder="Дворец, водопад, SUP…"
          class="h-11 min-w-0 flex-1 bg-transparent text-base text-graphite placeholder:text-muted focus:outline-none"
        />
        <button type="submit" class="btn-accent h-11 shrink-0 px-5 sm:px-6">Найти</button>
      </div>
    </form>

    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Быстрые категории">
      {
        quick.map((c) => {
          const Icon = ICONS[c.icon];
          return (
            <li>
              <a
                href={routes.category(c.slug)}
                class="inline-flex items-center gap-1.5 rounded-full border border-white/30 bg-white/10 px-3.5 py-1.5 text-sm text-white backdrop-blur-sm transition-colors hover:bg-white/20"
              >
                <Icon size={15} aria-hidden="true" />
                {c.shortTitle}
              </a>
            </li>
          );
        })
      }
    </ul>

    <dl class="mt-10 grid max-w-xl grid-cols-3 gap-4 border-t border-white/20 pt-6">
      <div><dt class="text-xs text-white/70">в каталоге</dt><dd class="font-serif text-3xl">{stats.listings}</dd></div>
      <div><dt class="text-xs text-white/70">направлений</dt><dd class="font-serif text-3xl">{stats.settlements}</dd></div>
      <div><dt class="text-xs text-white/70">в афише</dt><dd class="font-serif text-3xl">{stats.events}</dd></div>
    </dl>
  </div>
  <p class="absolute right-3 bottom-2 hidden text-[0.6875rem] text-white/60 sm:block">
    Фото: {photo.author}, {photo.license}, {photo.sourceName}
  </p>
</section>
