# ──────────────────────────────────────────────────────────────────────────────
# Фитон Крым — переменные окружения
# Скопируйте этот файл в .env.local и заполните значения
# ──────────────────────────────────────────────────────────────────────────────

# ── ЮКасса (YooKassa) — оплата картами Мир, Visa, Mastercard, СБП ─────────────
# Получить в личном кабинете: https://yookassa.ru/my/merchant/integration/api
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key

# ── Ozon Seller API — синхронизация товаров с маркетплейсом ───────────────────
# Получить в кабинете продавца: https://seller.ozon.ru/app/settings/api-keys
OZON_CLIENT_ID=your_client_id
OZON_API_KEY=your_api_key
# ID категории товаров в Ozon (косметика/уход за кожей)
OZON_CATEGORY_ID=6396

# ── Защита API эндпоинтов ─────────────────────────────────────────────────────
# Секрет для защиты маршрута /api/ozon/sync
API_SYNC_SECRET=change_this_to_a_random_secret

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://phytoncrimea.ru

# ──────────────────────────────────────────────────────────────────────────────
# ПРИМЕЧАНИЕ: Для production рекомендуется подключить базу данных
# npm install prisma @prisma/client
# Добавьте DATABASE_URL=postgresql://...
# ──────────────────────────────────────────────────────────────────────────────
